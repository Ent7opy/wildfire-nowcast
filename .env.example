# Wildfire Nowcast & Forecast - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: NASA FIRMS API Key
# =============================================================================
# Get your free API key at: https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=your_firms_api_key_here

# =============================================================================
# Database Configuration (defaults work for local Docker setup)
# =============================================================================
POSTGRES_USER=wildfire
POSTGRES_PASSWORD=wildfire
POSTGRES_DB=wildfire
# POSTGRES_HOST=localhost  # Uncomment for external DB
# POSTGRES_PORT=5432       # Uncomment for external DB

# =============================================================================
# API Configuration
# =============================================================================
# API_PUBLIC_BASE_URL=http://localhost:8000  # URL for API client connections

# =============================================================================
# Optional: FIRMS Ingest Settings
# =============================================================================
# FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT
# FIRMS_AREA=world
# FIRMS_DAY_RANGE=1
# FIRMS_WATERMARK_GRACE_MINUTES=90

# =============================================================================
# Optional: Weather Ingest Settings
# =============================================================================
# WEATHER_MODEL=gfs_0p25
# WEATHER_GFS_BASE_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl

# =============================================================================
# Optional: Data Freshness / Stale Behavior Policy (minutes)
# =============================================================================
# DATA_STALE_FIRMS_MINUTES=180
# DATA_STALE_WEATHER_MINUTES=360
# DATA_STALE_TERRAIN_MINUTES=10080
# DATA_STALE_PERIMETERS_MINUTES=4320
# DATA_STATUS_CRITICAL_SOURCES=firms,weather

# =============================================================================
# Optional: Denoiser Model Settings
# =============================================================================
# DENOISER_ENABLED=false
# DENOISER_REQUIRED=true
# DENOISER_MODEL_RUN_DIR=models/denoiser_v2/latest
# DENOISER_THRESHOLD=0.5
# DENOISER_STRICT_FEATURES=false

# =============================================================================
# Optional: Spread Forecast Calibration
# =============================================================================
# SPREAD_CALIBRATOR_RUN_DIR=models/spread_calibration/latest
# WEATHER_BIAS_CORRECTOR_PATH=models/weather_bias_corrector/latest.json
# STRICT_FORECAST_INPUTS=false
# FORECAST_FAIL_CLOSED_ON_STALE=true
# FORECAST_RESULT_CACHE_TTL_MINUTES=60
# SPREAD_MODEL_CATALOG_JSON={"v0_default":{"model_name":"HeuristicSpreadModelV0","model_params":{}}}
# SPREAD_MODEL_CATALOG_SIGNATURE=<hmac_sha256_hex_of_canonical_catalog_json>
# SPREAD_MODEL_CATALOG_SIGNING_KEY=<secret_key_for_catalog_signature_verification>
# SPREAD_MODEL_CATALOG_REQUIRE_SIGNATURE=false
